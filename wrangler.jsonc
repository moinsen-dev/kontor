{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kontor",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/static/*"]
  },
  // Per-IP limit for POST requests, enforced by Cloudflare; we store no IPs.
  "ratelimits": [
    { "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kontor",
      "database_id": "cf905edc-3910-4b4e-8745-86c314f53499",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "kontor.moinsen.dev", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": false }
}
